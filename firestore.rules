rules_version = '2';
// Ocata Vent 2 · regles de seguretat de Firestore (comptes, sortides privades, club, confidencialitat i amics)
// Com publicar-les: consola de Firebase → Firestore Database → Rules → enganxa aquest fitxer → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- qui és qui ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isOwner() { return signedIn() && me() == 'aHjoROUH3aQsHh6ksS3Tt1p5soF2'; }   // administrador inicial (Oriol)
    function isAdmin() { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(me()))); }
    function memberPath() { return /databases/$(database)/documents/members/$(me()); }
    function isApproved() { return signedIn() && exists(memberPath()) && get(memberPath()).data.estat == 'aprovat'; }
    function myClub() { return get(memberPath()).data.clubId; }
    function mySortida(sid) { return signedIn() && sid.matches(me() + '_[0-9]+'); }
    function memberData() { return get(memberPath()).data; }
    function inComissio(c) { return isAdmin() || (isApproved() && c in memberData().get('comissions', [])); }
    // Premium (members/{uid}.premium, només el dona l'administració): gestiona el seu club, amb tots els permisos dins del club
    function isPremium() { return isApproved() && memberData().get('premium', false) == true; }
    // Permisos delegables (members/{uid}.permisos): altes, rols, permisos, moderar, avisos. Administració i premium els tenen tots.
    function hasPerm(p) { return isAdmin() || isPremium() || (isApproved() && p in memberData().get('permisos', [])); }
    function permList() { return ['altes', 'rols', 'permisos', 'moderar', 'avisos', 'seguretat', 'planol', 'embarcacions']; }
    // Plànol de la base: dibuixar-lo (Junta o permís «planol») i gestionar-ne les embarcacions (Manteniment o permís «embarcacions»)
    function canPlan(club) { return isAdmin() || (isApproved() && club == myClub() && (hasPerm('planol') || inComissio('junta'))); }
    function canBoats(club) { return isAdmin() || (isApproved() && club == myClub() && (hasPerm('embarcacions') || inComissio('manteniment'))); }
    // Gestionar un soci (o un club): l'administració, qualsevol; la resta, només el seu club
    function sameClub(club) { return isAdmin() || club == myClub(); }
    function comsOf(club) {
      let p = /databases/$(database)/documents/clubs/$(club);
      return exists(p) ? get(p).data.comissions.keys() : ['junta', 'manteniment', 'economica'];
    }
    // Publicar avisos d'una comissió: ser-ne i tenir el permís «avisos» (administració i premium, a qualsevol comissió del club)
    function canAvis(c) { return isAdmin() || isPremium() || (isApproved() && c in memberData().get('comissions', []) && 'avisos' in memberData().get('permisos', [])); }
    // Moderar: retirar (esborrar) només el contingut del propi club; l'administració, el de qualsevol club
    function modera(d) { return isAdmin() || (hasPerm('moderar') && d.clubId == myClub()); }
    // Contingut «tothom» d'un altre club: qui modera només el pot amagar per al seu club (llista «amagat» amb ids de club)
    function amagaOk() {
      let a = resource.data.get('amagat', []).toSet();
      let b = request.resource.data.get('amagat', []).toSet();
      return hasPerm('moderar') && veu(resource.data) && resource.data.clubId != myClub()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amagat'])
        && request.resource.data.amagat is list && request.resource.data.amagat.size() <= 50
        && b.difference(a).hasOnly([myClub()]) && a.difference(b).hasOnly([myClub()]);
    }
    function gestor() { return hasPerm('altes') || hasPerm('rols') || hasPerm('permisos'); }
    // Comissions del club (clubs/{clubId}.comissions = {id: nom}); si encara no s'han editat, les de sempre
    function comsClub() {
      let p = /databases/$(database)/documents/clubs/$(myClub());
      return exists(p) ? get(p).data.comissions.keys() : ['junta', 'manteniment', 'economica'];
    }
    function clubOk() { return isApproved() && resource.data.clubId == myClub(); }
    function newClubOk() { return isApproved() && request.resource.data.clubId == myClub() && request.resource.data.userId == me(); }
    function expired() { return isApproved() && resource.data.get('caduca', null) != null && resource.data.caduca < request.time; }
    // Un soci només pot afegir, canviar o treure la seva pròpia clau d'un mapa (reaccions, apuntats, vist)
    function onlyMyKey(f) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([f])
        && request.resource.data.get(f, {}).diff(resource.data.get(f, {})).affectedKeys().hasOnly([me()]);
    }
    function nomOk(v, n) { return v is string && v.size() > 0 && v.size() <= n; }

    // ---------- confidencialitat ----------
    // Nivells: tothom (qualsevol soci aprovat de l'app), club, amics (els que el propietari ha posat a «lectors»:
    // els seus amics en el moment de desar-ho). «Ningú» = no es desa.
    // Avisos de seguretat: a més, «base» = també els socis que en aquell moment són a la base nàutica.
    // Resoldre avisos de seguretat: Junta, permís «seguretat», premium (o l'antic camp «responsable», mentre quedi)
    function isJunta() { return isAdmin() || isPremium() || (isApproved() && ('junta' in memberData().get('comissions', []) || 'seguretat' in memberData().get('permisos', []) || memberData().get('responsable', false) == true)); }
    function nivellOk(v) { return v in ['tothom', 'club', 'amics']; }
    function aLaBase() {
      let p = /databases/$(database)/documents/presencia/$(me());
      return exists(p) && get(p).data.estat == 'base' && get(p).data.clubId == myClub();
    }
    function lectorsOk(d) { return d.get('lectors', []) is list && d.get('lectors', []).size() <= 300; }
    function veu(d) {
      let v = d.get('visibilitat', 'club');
      return signedIn() && (d.userId == me() || (isApproved() && (v == 'tothom'
        || (v == 'club' && d.clubId == myClub())
        || me() in d.get('lectors', []))));   // «lectors» només s'omple quan és «amics» (l'app el buida si no)
    }
    function parell(a, b) { return a < b ? a + '_' + b : b + '_' + a; }

    // ---------- administradors ----------
    // Llista d'administradors addicionals (un document buit per UID). Només l'administrador inicial la gestiona.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }
    // Configuració global (admin.html): plantilles de rol per als clubs nous. La llegeixen els socis aprovats (web del club).
    match /config/{doc} {
      allow read: if isApproved() || isAdmin();
      allow write: if isAdmin() && doc == 'global'
        && request.resource.data.keys().hasOnly(['plantilles', 'actualitzat', 'actualitzatPer'])
        && request.resource.data.plantilles is map && request.resource.data.plantilles.size() <= 30
        && request.resource.data.actualitzatPer == me() && request.resource.data.actualitzat == request.time;
    }

    // ---------- socis ----------
    match /members/{uid} {
      allow read: if signedIn() && (uid == me() || (gestor() && sameClub(resource.data.clubId)));

      // Sol·licitud d'alta: només la pròpia, pendent (un administrador es pot donar d'alta aprovat), amb consentiment
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'email', 'nom', 'estat', 'consentVersio', 'consentAt', 'creat'])
        && request.resource.data.keys().hasAll(['userId', 'clubId', 'email', 'nom', 'estat', 'consentVersio', 'consentAt', 'creat'])
        && request.resource.data.userId == me()
        && request.resource.data.clubId == 'ocatavent'
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 80
        && (request.resource.data.estat == 'pendent' || (request.resource.data.estat == 'aprovat' && isAdmin()))
        && request.resource.data.consentVersio is string && request.resource.data.consentVersio.size() <= 20
        && request.resource.data.consentAt == request.time
        && request.resource.data.creat == request.time;

      // Aprovar, rebutjar o treure l'accés: permís «altes» (no a un mateix)
      allow update: if hasPerm('altes') && uid != me() && sameClub(resource.data.clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estat', 'revisatPer', 'revisatAt'])
        && request.resource.data.estat in ['pendent', 'aprovat', 'rebutjat']
        && request.resource.data.revisatPer == me()
        && request.resource.data.revisatAt == request.time;
      // El mateix soci tria la seva confidencialitat
      allow update: if signedIn() && uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['privacitat'])
        && request.resource.data.privacitat is map
        && request.resource.data.privacitat.keys().hasOnly(['mur', 'presencia', 'avisos', 'avisosBase', 'autoBase', 'intencions', 'anuncis'])
        && request.resource.data.privacitat.get('mur', 'club') in ['tothom', 'club', 'amics']
        && request.resource.data.privacitat.get('intencions', 'club') in ['tothom', 'club', 'amics']
        && request.resource.data.privacitat.get('anuncis', 'club') in ['tothom', 'club', 'amics']
        && request.resource.data.privacitat.get('presencia', 'club') in ['tothom', 'club', 'amics', 'ningu']
        && request.resource.data.privacitat.get('avisos', 'club') in ['tothom', 'club', 'amics', 'ningu']
        && request.resource.data.privacitat.get('avisosBase', true) is bool
        && request.resource.data.privacitat.get('autoBase', false) is bool;
      // Comissions i responsables: permís «rols»
      allow update: if hasPerm('rols') && sameClub(resource.data.clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comissions', 'responsable'])
        && request.resource.data.get('comissions', []) is list
        && request.resource.data.get('comissions', []).toSet().difference(comsOf(resource.data.clubId).toSet()).size() == 0
        && request.resource.data.get('responsable', false) is bool;
      // Permisos: permís «permisos» (no a un mateix, perquè ningú no se'ls pugi sol)
      // «permisos» = permisos efectius (rols del club + permisos extra), els recalcula la web de gestió; les regles només miren aquesta llista
      allow update: if hasPerm('permisos') && uid != me() && sameClub(resource.data.clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['permisos', 'rolsClub', 'permisosExtra'])
        && request.resource.data.permisos is list
        && request.resource.data.permisos.toSet().difference(permList().toSet()).size() == 0
        && request.resource.data.get('permisosExtra', []) is list
        && request.resource.data.get('permisosExtra', []).toSet().difference(permList().toSet()).size() == 0
        && request.resource.data.get('rolsClub', []) is list && request.resource.data.get('rolsClub', []).size() <= 20;
      // Web de gestió: dades bàsiques (nom) per a qui gestiona altes al club
      allow update: if hasPerm('altes') && sameClub(resource.data.clubId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nom'])
        && nomOk(request.resource.data.nom, 80);
      // Només l'administració: fer premium i canviar de club (a un club que existeixi)
      allow update: if isAdmin() && uid != me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['premium', 'clubId'])
        && request.resource.data.get('premium', false) is bool
        && (request.resource.data.clubId == 'ocatavent' || exists(/databases/$(database)/documents/clubs/$(request.resource.data.clubId)));

      // El mateix soci corregeix el seu nom (⋮ ▸ Compte ▸ Dades personals)
      allow update: if signedIn() && uid == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nom'])
        && nomOk(request.resource.data.nom, 80);

      // Esborrar: el mateix soci (esborrar el compte) o un administrador
      allow delete: if signedIn() && (uid == me() || isAdmin());

      // Telèfon opcional (privat/contacte): l'escriu el soci; el llegeixen ell, la Junta i el permís «Seguretat» del seu club
      match /privat/{doc} {
        allow read: if signedIn() && (uid == me() || (isJunta() && sameClub(get(/databases/$(database)/documents/members/$(uid)).data.clubId)));
        allow create, update: if signedIn() && uid == me() && doc == 'contacte'
          && request.resource.data.keys().hasOnly(['telefon', 'at'])
          && request.resource.data.telefon is string && request.resource.data.telefon.size() >= 6 && request.resource.data.telefon.size() <= 20
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && (uid == me() || isAdmin());
      }
    }

    // ---------- sortides (Fase 1: sempre privades) ----------
    // Identificador del document: <uid>_<id de la sortida>. La ruta va trossejada a la subcol·lecció «trams».
    match /sortides/{sid} {
      // Llegir: només el propietari. Els administradors NO veuen les sortides privades.
      allow read: if signedIn() && resource.data.userId == me();

      // Pujar o tornar a pujar: socis aprovats, a nom propi i privada
      allow create, update: if isApproved() && mySortida(sid)
        && (resource == null || resource.data.userId == me())
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'visibilitat', 'tripId', 'nom', 'act', 'inici', 'fi', 'distNm', 'trams', 'v', 'pujada'])
        && request.resource.data.userId == me()
        && request.resource.data.clubId == myClub()
        && request.resource.data.visibilitat == 'privat'
        && request.resource.data.tripId is int
        && sid == me() + '_' + string(request.resource.data.tripId)
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 120
        && request.resource.data.act is string && request.resource.data.act.size() <= 20
        && request.resource.data.inici is number && request.resource.data.fi is number
        && request.resource.data.distNm is number
        && request.resource.data.trams is int && request.resource.data.trams >= 1 && request.resource.data.trams <= 20
        && request.resource.data.pujada == request.time;

      // Esborrar: sempre el propietari, encara que ja no sigui soci (dret a esborrar les dades)
      allow delete: if mySortida(sid);

      match /trams/{tid} {
        allow read: if signedIn() && resource.data.userId == me();
        allow create, update: if isApproved() && mySortida(sid)
          && (resource == null || resource.data.userId == me())
          && request.resource.data.keys().hasOnly(['userId', 'i', 'd'])
          && request.resource.data.userId == me()
          && request.resource.data.i is int && request.resource.data.i >= 0 && request.resource.data.i < 20
          && tid == string(request.resource.data.i)
          && request.resource.data.d is string && request.resource.data.d.size() <= 500000;
        allow delete: if mySortida(sid);
      }
    }

    // ---------- club (Fase 2): només socis aprovats del mateix club ----------
    // Publicacions al mur: <uid>_<id de la sortida>
    match /publicacions/{pid} {
      allow update: if amagaOk();
      allow read: if (signedIn() && pid.matches(me() + '_[0-9]+')) || veu(resource.data);
      allow create: if newClubOk() && pid == me() + '_' + string(request.resource.data.tripId)
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'visibilitat', 'tripId', 'nom', 'act', 'inici', 'fi', 'titol', 'comentari', 'ruta',
             'distNm', 'durS', 'maxKn', 'avgKn', 'vent', 'onada', 'veredicte', 'reaccions', 'editada', 'creat', 'lectors'])
        && nivellOk(request.resource.data.visibilitat) && lectorsOk(request.resource.data)
        && request.resource.data.tripId is int
        && nomOk(request.resource.data.nom, 80) && nomOk(request.resource.data.titol, 60)
        && request.resource.data.comentari is string && request.resource.data.comentari.size() <= 280
        && (request.resource.data.ruta == null || (request.resource.data.ruta is string && request.resource.data.ruta.size() <= 6000))
        && request.resource.data.reaccions == {}
        && request.resource.data.creat == request.time;
      // El propietari edita el títol, el comentari, la ruta i qui ho veu
      allow update: if signedIn() && resource.data.userId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titol', 'comentari', 'ruta', 'editada', 'visibilitat', 'lectors'])
        && nivellOk(request.resource.data.visibilitat) && lectorsOk(request.resource.data)
        && nomOk(request.resource.data.titol, 60)
        && request.resource.data.comentari is string && request.resource.data.comentari.size() <= 280
        && (request.resource.data.ruta == null || (request.resource.data.ruta is string && request.resource.data.ruta.size() <= 6000));
      // Reaccionar: cada soci només la seva
      allow update: if veu(resource.data) && onlyMyKey('reaccions')
        && (!(me() in request.resource.data.reaccions) || request.resource.data.reaccions[me()] in ['up', 'clap', 'wow', 'down']);
      allow delete: if signedIn() && (resource.data.userId == me() || modera(resource.data));
    }

    // «Qui surt»: intencions de sortida, caduquen l'endemà
    match /intencions/{id} {
      allow update: if amagaOk();
      allow read: if veu(resource.data);
      allow create: if newClubOk()
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'nom', 'act', 'dia', 'hora', 'apuntats', 'caduca', 'creat', 'visibilitat', 'lectors'])
        && nivellOk(request.resource.data.visibilitat) && lectorsOk(request.resource.data)
        && nomOk(request.resource.data.nom, 80) && request.resource.data.act is string && request.resource.data.act.size() <= 20
        && request.resource.data.dia is string && request.resource.data.dia.size() == 10
        && request.resource.data.hora is string && request.resource.data.hora.size() <= 5
        && request.resource.data.apuntats == {} && request.resource.data.caduca is timestamp
        && request.resource.data.caduca < request.time + duration.value(17, 'd')
        && request.resource.data.creat == request.time;
      allow update: if veu(resource.data) && onlyMyKey('apuntats')
        && (!(me() in request.resource.data.apuntats) || nomOk(request.resource.data.apuntats[me()], 80));
      allow update: if signedIn() && resource.data.userId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibilitat', 'lectors'])
        && nivellOk(request.resource.data.visibilitat) && lectorsOk(request.resource.data);
      allow delete: if signedIn() && (resource.data.userId == me() || modera(resource.data) || expired());
    }

    // Avisos de la junta i les comissions
    function avisOk(d) {
      return nomOk(d.titol, 80) && nomOk(d.text, 600) && d.fixat is bool
        && (d.get('data', null) == null || (d.data is string && d.data.size() == 10))
        && (d.get('caduca', null) == null || (d.caduca is timestamp && d.caduca < request.time + duration.value(400, 'd')));
    }
    match /avisos/{id} {
      allow read: if clubOk();
      // Data opcional de l'activitat (AAAA-MM-DD): amb data, caduca l'endemà; sense data, no caduca (caduca = null)
      allow create: if newClubOk() && canAvis(request.resource.data.comissio)
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'comissio', 'titol', 'text', 'fixat', 'data', 'caduca', 'creat', 'autorNom', 'vist', 'inscripcio', 'apuntats'])
        && request.resource.data.get('inscripcio', false) is bool && request.resource.data.get('apuntats', {}) == {}
        && request.resource.data.comissio in comsClub()
        && avisOk(request.resource.data)
        && nomOk(request.resource.data.autorNom, 80) && request.resource.data.vist == {}
        && request.resource.data.creat == request.time;
      // L'autor el pot editar (títol, text, fixat, data i si pregunta qui s'apunta)
      allow update: if signedIn() && resource.data.userId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titol', 'text', 'fixat', 'data', 'caduca', 'editat', 'inscripcio'])
        && request.resource.data.get('inscripcio', false) is bool
        && avisOk(request.resource.data);
      // «M'hi apunto»: cadascú la seva clau (nom); només si l'avís ho pregunta (desapuntar-se, sempre)
      allow update: if clubOk() && onlyMyKey('apuntats')
        && (!(me() in request.resource.data.get('apuntats', {})) || (resource.data.get('inscripcio', false) == true && nomOk(request.resource.data.apuntats[me()], 80)));
      allow update: if clubOk() && onlyMyKey('vist')
        && (!(me() in request.resource.data.vist) || request.resource.data.vist[me()] == true);
      allow delete: if signedIn() && (resource.data.userId == me() || inComissio(resource.data.comissio) || modera(resource.data) || expired());
    }

    // Anuncis dels socis
    match /anuncis/{id} {
      allow update: if amagaOk();
      allow read: if veu(resource.data);
      allow create: if newClubOk()
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'cat', 'titol', 'text', 'caduca', 'creat', 'autorNom', 'visibilitat', 'lectors'])
        && nivellOk(request.resource.data.visibilitat) && lectorsOk(request.resource.data)
        && request.resource.data.cat in ['tripulacio', 'material', 'altres']
        && nomOk(request.resource.data.titol, 80)
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.caduca is timestamp
        && request.resource.data.caduca < request.time + duration.value(61, 'd')
        && nomOk(request.resource.data.autorNom, 80)
        && request.resource.data.creat == request.time;
      allow update: if signedIn() && resource.data.userId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibilitat', 'lectors', 'cat', 'titol', 'text', 'caduca', 'editat'])
        && nivellOk(request.resource.data.visibilitat) && lectorsOk(request.resource.data)
        && request.resource.data.cat in ['tripulacio', 'material', 'altres']
        && nomOk(request.resource.data.titol, 80)
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.caduca is timestamp
        && request.resource.data.caduca < request.time + duration.value(61, 'd')
        && (!('editat' in request.resource.data) || request.resource.data.editat == true);
      allow delete: if signedIn() && (resource.data.userId == me() || modera(resource.data) || expired());

      // Qui s'hi ha interessat: només ho veuen l'autor de l'anunci i el mateix soci
      match /interessats/{uid} {
        allow read: if signedIn() && (uid == me() || get(/databases/$(database)/documents/anuncis/$(id)).data.userId == me());
        allow create, update: if isApproved() && uid == me()
          && request.resource.data.keys().hasOnly(['userId', 'nom'])
          && request.resource.data.userId == me() && nomOk(request.resource.data.nom, 80);
        allow delete: if signedIn() && (uid == me() || get(/databases/$(database)/documents/anuncis/$(id)).data.userId == me());
      }
    }

    // Presència a la base o a l'aigua: la veu qui el soci tria a Confidencialitat
    match /presencia/{uid} {
      allow read: if signedIn() && (uid == me() || veu(resource.data));
      allow create, update: if isApproved() && uid == me()
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'nom', 'estat', 'act', 'lat', 'lon', 'sog', 'desde', 'visibilitat', 'lectors', 'actualitzat'])
        && request.resource.data.userId == me() && request.resource.data.clubId == myClub()
        && nomOk(request.resource.data.nom, 80)
        && request.resource.data.estat in ['base', 'aigua'] && nivellOk(request.resource.data.visibilitat) && lectorsOk(request.resource.data)
        && request.resource.data.lat is number && request.resource.data.lon is number
        && request.resource.data.actualitzat == request.time;
      allow delete: if signedIn() && (uid == me() || isAdmin());
    }

    // Avisos de seguretat en ruta (sense vent i lluny, vent massa fort, onades perilloses).
    // Els crea el mòbil de qui navega; els veu qui el soci tria a Confidencialitat (per defecte, el club i la gent a la base).
    // Els pot marcar com a resolts la Junta, qui té el permís «seguretat» o qui és a la base.
    // Identificador: <uid>_<inici de la sortida>_<tipus>.
    function alertaOk(id) {
      return request.resource.data.keys().hasOnly(['clubId', 'tipus', 'userId', 'nom', 'act', 'desde', 'lat', 'lon', 'posAt', 'valor', 'resolta', 'creat', 'resoltaPer', 'resoltaAt', 'visibilitat', 'lectors', 'base', 'ajudants'])
        && nivellOk(request.resource.data.visibilitat) && lectorsOk(request.resource.data)
        && request.resource.data.get('base', false) is bool
        && request.resource.data.userId == me() && request.resource.data.clubId == myClub()
        && request.resource.data.tipus in ['sense-vent', 'vent-fort', 'onades', 'ajuda']
        && id == me() + '_' + string(request.resource.data.desde) + '_' + request.resource.data.tipus
        && nomOk(request.resource.data.nom, 80) && request.resource.data.lat is number && request.resource.data.lon is number;
    }
    match /alertes/{id} {
      allow read: if veu(resource.data) || (resource.data.get('base', false) == true && isApproved() && resource.data.clubId == myClub() && aLaBase());
      allow create: if isApproved() && alertaOk(id) && request.resource.data.resolta == false && request.resource.data.creat == request.time
        && request.resource.data.get('ajudants', {}) == {};
      // «Vaig a ajudar»: qui veu l'avís s'hi afegeix (o se'n treu) a «ajudants» amb el seu nom i la seva posició
      allow update: if (veu(resource.data) || (resource.data.get('base', false) == true && isApproved() && resource.data.clubId == myClub() && aLaBase()))
        && resource.data.userId != me() && resource.data.resolta == false
        && onlyMyKey('ajudants') && request.resource.data.ajudants.size() <= 3   // com a màxim 3 persones hi van
        && (!(me() in request.resource.data.ajudants)
          || (request.resource.data.ajudants[me()].keys().hasOnly(['nom', 'lat', 'lon', 'at'])
            && nomOk(request.resource.data.ajudants[me()].nom, 80)
            && request.resource.data.ajudants[me()].lat is number && request.resource.data.ajudants[me()].lon is number
            && request.resource.data.ajudants[me()].at == request.time));
      allow update: if isApproved() && resource.data.userId == me() && alertaOk(id);
      allow update: if (veu(resource.data) || (resource.data.get('base', false) == true && isApproved() && resource.data.clubId == myClub() && aLaBase()))
        && (isJunta() || aLaBase())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolta', 'resoltaPer', 'resoltaAt'])
        && request.resource.data.resolta == true && request.resource.data.resoltaPer == me()
        && request.resource.data.resoltaAt == request.time;
      allow delete: if signedIn() && resource.data.userId == me();
    }

    // ---------- configuració del club (Administració): comissions ----------
    // La Junta no es pot eliminar (la seguretat en depèn); sí reanomenar. Ho edita qui té el permís «rols».
    // L'administració veu i crea tots els clubs (nom); premium i «rols» editen el seu.
    match /clubs/{club} {
      allow read: if isAdmin() || (isApproved() && club == myClub());
      allow create, update: if (isAdmin() || (hasPerm('rols') && club == myClub()))
        && request.resource.data.keys().hasOnly(['nom', 'comissions', 'rols', 'actualitzat', 'actualitzatPer'])
        && request.resource.data.get('rols', {}) is map && request.resource.data.get('rols', {}).size() <= 30
        && request.resource.data.get('nom', '') is string && request.resource.data.get('nom', '').size() <= 80
        && request.resource.data.comissions is map && request.resource.data.comissions.size() <= 20
        && 'junta' in request.resource.data.comissions.keys()
        && request.resource.data.actualitzatPer == me() && request.resource.data.actualitzat == request.time;
    }

    // ---------- plànol de la base i embarcacions ----------
    match /clubs/{club}/planol/{d} {
      allow read: if isAdmin() || (isApproved() && club == myClub());
      allow write: if canPlan(club) && d == 'actual'
        && request.resource.data.keys().hasOnly(['objs', 'bg', 'origin', 'vista', 'costa', 'actualitzat', 'actualitzatPer'])
        && (request.resource.data.get('costa', null) == null || (request.resource.data.costa is number && request.resource.data.costa >= 0 && request.resource.data.costa < 360))
        && request.resource.data.objs is list && request.resource.data.objs.size() <= 600
        && request.resource.data.actualitzatPer == me();
    }
    match /embarcacions/{id} {
      function boatOk(d) {
        return d.keys().hasOnly(['clubId', 't', 'label', 'vela', 'prop', 'propUid', 'coprop', 'ocult', 'estat', 'notes', 'place', 'historial', 'pendent', 'actualitzat', 'actualitzatPer'])
          && d.estat in ['lloc', 'navegant', 'reparacio'] && d.get('historial', []) is list && d.get('historial', []).size() <= 20
          && d.get('notes', '') is string && d.get('notes', '').size() <= 500 && d.get('pendent', false) is bool && d.actualitzatPer == me();
      }
      // Dades que un soci pot proposar i que ha de validar Manteniment (pendent = true)
      function dadesKeys() { return ['t', 'label', 'vela', 'coprop', 'place']; }
      allow read: if isAdmin() || (isApproved() && resource.data.clubId == myClub());
      // Alta: qui gestiona les embarcacions (validada o no), o un soci per a ell mateix, pendent de validar
      allow create: if boatOk(request.resource.data) && (canBoats(request.resource.data.clubId)
        || (isApproved() && request.resource.data.clubId == myClub() && request.resource.data.propUid == me() && request.resource.data.pendent == true));
      allow update: if boatOk(request.resource.data) && request.resource.data.clubId == resource.data.clubId
        && (canBoats(resource.data.clubId)
          // el propietari: estat, notes, foto i nom ocult lliurement; les dades (tipus, nom, vela, copropietaris, plaça) queden pendents de validar
          || (resource.data.propUid == me()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estat', 'notes', 'ocult', 'prop', 'historial', 'pendent', 'actualitzat', 'actualitzatPer', 't', 'label', 'vela', 'coprop', 'place'])
            && (request.resource.data.get('pendent', false) == true || (resource.data.get('pendent', false) == false && !request.resource.data.diff(resource.data).affectedKeys().hasAny(dadesKeys())))));
      // Baixa: qui gestiona; el propietari, només si encara és pendent (retira la proposta)
      allow delete: if canBoats(resource.data.clubId) || (resource.data.propUid == me() && resource.data.get('pendent', false) == true);
      function boat() { return get(/databases/$(database)/documents/embarcacions/$(id)).data; }
      // nom del propietari quan és ocult: el veuen el propietari i qui gestiona les embarcacions (Manteniment) o la Junta
      match /privat/{d} {
        allow read: if signedIn() && (boat().propUid == me() || canBoats(boat().clubId) || canPlan(boat().clubId));
        allow write: if signedIn() && (boat().propUid == me() || canBoats(boat().clubId)) && request.resource.data.keys().hasOnly(['prop']);
        allow delete: if signedIn() && (boat().propUid == me() || canBoats(boat().clubId));
      }
      // foto comprimida (JPEG en base64, < 150 kB)
      match /foto/{d} {
        allow read: if isAdmin() || (isApproved() && boat().clubId == myClub());
        allow write: if signedIn() && (boat().propUid == me() || canBoats(boat().clubId))
          && request.resource.data.keys().hasOnly(['data', 'at', 'per']) && request.resource.data.data is string && request.resource.data.data.size() < 150000;
        allow delete: if signedIn() && (boat().propUid == me() || canBoats(boat().clubId));
      }
    }

    // ---------- avisos de la base: notes, fets (incidències) i preguntes al propietari ----------
    // nota/fet sense embarcació: públic al club. fet d'una embarcació: autor, propietari i Manteniment. pregunta: només autor i propietari.
    match /fets/{id} {
      function part(d) { return d.userId == me() || d.get('propUid', '') == me() || (d.tipus != 'pregunta' && canBoats(d.clubId)); }
      function veuFet(d) { return isApproved() && d.clubId == myClub() && (d.get('public', false) == true || part(d)); }
      allow read: if isAdmin() || veuFet(resource.data);
      allow create: if isApproved() && request.resource.data.clubId == myClub() && request.resource.data.userId == me()
        && request.resource.data.keys().hasOnly(['clubId', 'userId', 'autorNom', 'tipus', 'text', 'boatId', 'placeId', 'propUid', 'public', 'estat', 'respostes', 'vist', 'creat', 'darrer'])
        && request.resource.data.tipus in ['nota', 'fet', 'pregunta']
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && nomOk(request.resource.data.autorNom, 80)
        && request.resource.data.estat == 'obert' && request.resource.data.respostes.size() == 0
        && request.resource.data.public == (request.resource.data.get('boatId', null) == null)
        && (request.resource.data.tipus != 'pregunta' || request.resource.data.get('boatId', null) != null)
        && (request.resource.data.get('boatId', null) == null
          || request.resource.data.get('propUid', null) == get(/databases/$(database)/documents/embarcacions/$(request.resource.data.boatId)).data.get('propUid', null))
        && request.resource.data.creat == request.time;
      // respondre i marcar vist: qui hi participa (en els públics, qualsevol soci del club); tancar: autor, propietari o Manteniment
      allow update: if veuFet(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['respostes', 'vist', 'darrer', 'estat'])
        && request.resource.data.respostes is list && request.resource.data.respostes.size() <= 40
        && request.resource.data.estat in ['obert', 'tancat']
        && (part(resource.data) || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['estat']));
      allow delete: if signedIn() && (resource.data.userId == me() || canBoats(resource.data.clubId) || isAdmin());
    }

    // ---------- amics (mutus) i perfils ----------
    // Perfil mínim per trobar socis i afegir-los com a amics: només el nom i el club.
    match /perfils/{uid} {
      allow read: if isApproved();
      allow create, update: if isApproved() && uid == me()
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'nom'])
        && request.resource.data.userId == me() && request.resource.data.clubId == myClub() && nomOk(request.resource.data.nom, 80);
      allow delete: if signedIn() && (uid == me() || isAdmin());
    }
    // Amistat: <uid menor>_<uid major>. L'envia «de», l'accepta «a»; qualsevol dels dos l'esborra.
    match /amistats/{id} {
      allow read: if signedIn() && me() in resource.data.uids;
      allow create: if isApproved()
        && request.resource.data.keys().hasOnly(['uids', 'de', 'a', 'noms', 'estat', 'creat'])
        && request.resource.data.de == me() && request.resource.data.a != me()
        && request.resource.data.uids is list && request.resource.data.uids.size() == 2
        && me() in request.resource.data.uids && request.resource.data.a in request.resource.data.uids
        && id == parell(request.resource.data.de, request.resource.data.a)
        && request.resource.data.noms is map && request.resource.data.estat == 'pendent'
        && request.resource.data.creat == request.time;
      allow update: if signedIn() && resource.data.a == me() && resource.data.estat == 'pendent'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estat', 'acceptadaAt'])
        && request.resource.data.estat == 'acceptada' && request.resource.data.acceptadaAt == request.time;
      allow delete: if signedIn() && me() in resource.data.uids;
    }

    // Qualsevol altra cosa: tancada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
