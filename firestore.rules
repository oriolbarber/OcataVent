rules_version = '2';
// Ocata Vent 2 · regles de seguretat de Firestore (Fase 1: comptes i sortides privades)
// Com publicar-les: consola de Firebase → Firestore Database → Rules → enganxa aquest fitxer → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- qui és qui ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isOwner() { return signedIn() && me() == 'aHjoROUH3aQsHh6ksS3Tt1p5soF2'; }   // administrador inicial (Oriol)
    function isAdmin() { return isOwner() || (signedIn() && exists(/databases/$(database)/documents/admins/$(me()))); }
    function memberPath() { return /databases/$(database)/documents/members/$(me()); }
    function isApproved() { return signedIn() && exists(memberPath()) && get(memberPath()).data.estat == 'aprovat'; }
    function myClub() { return get(memberPath()).data.clubId; }
    function mySortida(sid) { return signedIn() && sid.matches(me() + '_[0-9]+'); }
    function memberData() { return get(memberPath()).data; }
    function isResp() { return isAdmin() || (isApproved() && memberData().get('responsable', false) == true); }
    function inComissio(c) { return isAdmin() || (isApproved() && c in memberData().get('comissions', [])); }
    function clubOk() { return isApproved() && resource.data.clubId == myClub(); }
    function newClubOk() { return isApproved() && request.resource.data.clubId == myClub() && request.resource.data.userId == me(); }
    function expired() { return isApproved() && resource.data.caduca < request.time; }
    // Un soci només pot afegir, canviar o treure la seva pròpia clau d'un mapa (reaccions, apuntats, vist)
    function onlyMyKey(f) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([f])
        && request.resource.data[f].diff(resource.data[f]).affectedKeys().hasOnly([me()]);
    }
    function nomOk(v, n) { return v is string && v.size() > 0 && v.size() <= n; }

    // ---------- administradors ----------
    // Llista d'administradors addicionals (un document buit per UID). Només l'administrador inicial la gestiona.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if isOwner();
    }

    // ---------- socis ----------
    match /members/{uid} {
      allow read: if signedIn() && (uid == me() || isAdmin());

      // Sol·licitud d'alta: només la pròpia, pendent (un administrador es pot donar d'alta aprovat), amb consentiment
      allow create: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'email', 'nom', 'estat', 'consentVersio', 'consentAt', 'creat'])
        && request.resource.data.keys().hasAll(['userId', 'clubId', 'email', 'nom', 'estat', 'consentVersio', 'consentAt', 'creat'])
        && request.resource.data.userId == me()
        && request.resource.data.clubId == 'ocatavent'
        && request.resource.data.email == request.auth.token.get('email', '')
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 80
        && (request.resource.data.estat == 'pendent' || (request.resource.data.estat == 'aprovat' && isAdmin()))
        && request.resource.data.consentVersio is string && request.resource.data.consentVersio.size() <= 20
        && request.resource.data.consentAt == request.time
        && request.resource.data.creat == request.time;

      // Aprovar, rebutjar o treure l'accés: només administradors i només aquests camps
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estat', 'revisatPer', 'revisatAt'])
        && request.resource.data.estat in ['pendent', 'aprovat', 'rebutjat']
        && request.resource.data.revisatPer == me()
        && request.resource.data.revisatAt == request.time;
      // Comissions i responsables: només administradors
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comissions', 'responsable'])
        && request.resource.data.get('comissions', []) is list
        && request.resource.data.get('comissions', []).toSet().difference(['junta', 'manteniment', 'economica'].toSet()).size() == 0
        && request.resource.data.get('responsable', false) is bool;

      // Esborrar: el mateix soci (esborrar el compte) o un administrador
      allow delete: if signedIn() && (uid == me() || isAdmin());
    }

    // ---------- sortides (Fase 1: sempre privades) ----------
    // Identificador del document: <uid>_<id de la sortida>. La ruta va trossejada a la subcol·lecció «trams».
    match /sortides/{sid} {
      // Llegir: només el propietari. Els administradors NO veuen les sortides privades.
      allow read: if signedIn() && resource.data.userId == me();

      // Pujar o tornar a pujar: socis aprovats, a nom propi i privada
      allow create, update: if isApproved() && mySortida(sid)
        && (resource == null || resource.data.userId == me())
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'visibilitat', 'tripId', 'nom', 'act', 'inici', 'fi', 'distNm', 'trams', 'v', 'pujada'])
        && request.resource.data.userId == me()
        && request.resource.data.clubId == myClub()
        && request.resource.data.visibilitat == 'privat'
        && request.resource.data.tripId is int
        && sid == me() + '_' + string(request.resource.data.tripId)
        && request.resource.data.nom is string && request.resource.data.nom.size() <= 120
        && request.resource.data.act is string && request.resource.data.act.size() <= 20
        && request.resource.data.inici is number && request.resource.data.fi is number
        && request.resource.data.distNm is number
        && request.resource.data.trams is int && request.resource.data.trams >= 1 && request.resource.data.trams <= 20
        && request.resource.data.pujada == request.time;

      // Esborrar: sempre el propietari, encara que ja no sigui soci (dret a esborrar les dades)
      allow delete: if mySortida(sid);

      match /trams/{tid} {
        allow read: if signedIn() && resource.data.userId == me();
        allow create, update: if isApproved() && mySortida(sid)
          && (resource == null || resource.data.userId == me())
          && request.resource.data.keys().hasOnly(['userId', 'i', 'd'])
          && request.resource.data.userId == me()
          && request.resource.data.i is int && request.resource.data.i >= 0 && request.resource.data.i < 20
          && tid == string(request.resource.data.i)
          && request.resource.data.d is string && request.resource.data.d.size() <= 500000;
        allow delete: if mySortida(sid);
      }
    }

    // ---------- club (Fase 2): només socis aprovats del mateix club ----------
    // Publicacions al mur: <uid>_<id de la sortida>
    match /publicacions/{pid} {
      allow read: if (signedIn() && pid.matches(me() + '_[0-9]+')) || clubOk();
      allow create: if newClubOk() && pid == me() + '_' + string(request.resource.data.tripId)
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'visibilitat', 'tripId', 'nom', 'act', 'inici', 'fi', 'titol', 'comentari', 'ruta',
             'distNm', 'durS', 'maxKn', 'avgKn', 'vent', 'onada', 'veredicte', 'reaccions', 'editada', 'creat'])
        && request.resource.data.visibilitat == 'club'
        && request.resource.data.tripId is int
        && nomOk(request.resource.data.nom, 80) && nomOk(request.resource.data.titol, 60)
        && request.resource.data.comentari is string && request.resource.data.comentari.size() <= 280
        && (request.resource.data.ruta == null || (request.resource.data.ruta is string && request.resource.data.ruta.size() <= 6000))
        && request.resource.data.reaccions == {}
        && request.resource.data.creat == request.time;
      // El propietari edita el títol, el comentari i la ruta
      allow update: if signedIn() && resource.data.userId == me()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['titol', 'comentari', 'ruta', 'editada'])
        && nomOk(request.resource.data.titol, 60)
        && request.resource.data.comentari is string && request.resource.data.comentari.size() <= 280
        && (request.resource.data.ruta == null || (request.resource.data.ruta is string && request.resource.data.ruta.size() <= 6000));
      // Reaccionar: cada soci només la seva
      allow update: if clubOk() && onlyMyKey('reaccions')
        && (!(me() in request.resource.data.reaccions) || request.resource.data.reaccions[me()] in ['up', 'clap', 'wow', 'down']);
      allow delete: if signedIn() && (resource.data.userId == me() || isAdmin());
    }

    // «Qui surt»: intencions de sortida, caduquen l'endemà
    match /intencions/{id} {
      allow read: if clubOk();
      allow create: if newClubOk()
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'nom', 'act', 'dia', 'hora', 'apuntats', 'caduca', 'creat'])
        && nomOk(request.resource.data.nom, 80) && request.resource.data.act is string && request.resource.data.act.size() <= 20
        && request.resource.data.dia is string && request.resource.data.dia.size() == 10
        && request.resource.data.hora is string && request.resource.data.hora.size() <= 5
        && request.resource.data.apuntats == {} && request.resource.data.caduca is timestamp
        && request.resource.data.caduca < request.time + duration.value(4, 'd')
        && request.resource.data.creat == request.time;
      allow update: if clubOk() && onlyMyKey('apuntats')
        && (!(me() in request.resource.data.apuntats) || nomOk(request.resource.data.apuntats[me()], 80));
      allow delete: if signedIn() && (resource.data.userId == me() || isAdmin() || expired());
    }

    // Avisos de la junta i les comissions
    match /avisos/{id} {
      allow read: if clubOk();
      allow create: if newClubOk() && inComissio(request.resource.data.comissio)
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'comissio', 'titol', 'text', 'fixat', 'caduca', 'creat', 'autorNom', 'vist'])
        && request.resource.data.comissio in ['junta', 'manteniment', 'economica']
        && nomOk(request.resource.data.titol, 80) && nomOk(request.resource.data.text, 600)
        && request.resource.data.fixat is bool && request.resource.data.caduca is timestamp
        && nomOk(request.resource.data.autorNom, 80) && request.resource.data.vist == {}
        && request.resource.data.creat == request.time;
      allow update: if clubOk() && onlyMyKey('vist')
        && (!(me() in request.resource.data.vist) || request.resource.data.vist[me()] == true);
      allow delete: if signedIn() && (resource.data.userId == me() || inComissio(resource.data.comissio) || expired());
    }

    // Anuncis dels socis
    match /anuncis/{id} {
      allow read: if clubOk();
      allow create: if newClubOk()
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'cat', 'titol', 'text', 'caduca', 'creat', 'autorNom'])
        && request.resource.data.cat in ['tripulacio', 'material', 'altres']
        && nomOk(request.resource.data.titol, 80)
        && request.resource.data.text is string && request.resource.data.text.size() <= 400
        && request.resource.data.caduca is timestamp
        && request.resource.data.caduca < request.time + duration.value(31, 'd')
        && nomOk(request.resource.data.autorNom, 80)
        && request.resource.data.creat == request.time;
      allow delete: if signedIn() && (resource.data.userId == me() || isAdmin() || expired());

      // Qui s'hi ha interessat: només ho veuen l'autor de l'anunci i el mateix soci
      match /interessats/{uid} {
        allow read: if signedIn() && (uid == me() || get(/databases/$(database)/documents/anuncis/$(id)).data.userId == me());
        allow create, update: if isApproved() && uid == me()
          && request.resource.data.keys().hasOnly(['userId', 'nom'])
          && request.resource.data.userId == me() && nomOk(request.resource.data.nom, 80);
        allow delete: if signedIn() && (uid == me() || get(/databases/$(database)/documents/anuncis/$(id)).data.userId == me());
      }
    }

    // Presència a la base o a l'aigua: la veuen els responsables, o tot el club si el soci ho tria
    match /presencia/{uid} {
      allow read: if signedIn() && (uid == me() || (clubOk() && (resource.data.visib == 'club' || isResp())));
      allow create, update: if isApproved() && uid == me()
        && request.resource.data.keys().hasOnly(['userId', 'clubId', 'nom', 'estat', 'act', 'lat', 'lon', 'desde', 'retorn', 'visib', 'actualitzat'])
        && request.resource.data.userId == me() && request.resource.data.clubId == myClub()
        && nomOk(request.resource.data.nom, 80)
        && request.resource.data.estat in ['base', 'aigua'] && request.resource.data.visib in ['resp', 'club']
        && request.resource.data.lat is number && request.resource.data.lon is number
        && request.resource.data.actualitzat == request.time;
      allow delete: if signedIn() && (uid == me() || isAdmin());
    }

    // Alertes «no ha tornat a l'hora»: les crea GitHub Actions (compte de servei, fora d'aquestes regles).
    // Les veuen els responsables del club i la mateixa persona; un responsable la pot marcar com a resolta.
    match /alertes/{id} {
      allow read: if signedIn() && (resource.data.userId == me() || (clubOk() && isResp()));
      allow update: if clubOk() && isResp()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolta', 'resoltaPer', 'resoltaAt'])
        && request.resource.data.resolta == true && request.resource.data.resoltaPer == me()
        && request.resource.data.resoltaAt == request.time;
      allow create, delete: if false;
    }

    // Qualsevol altra cosa: tancada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
