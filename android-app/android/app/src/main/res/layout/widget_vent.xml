<?xml version="1.0" encoding="utf-8"?>
<!-- Widget d'Ocata Vent: a dalt, «ARA» + nota i veredicte d'ara a l'esquerra; embarcació, vent, onada i d'on surten les dades a la dreta.
     A sota, el resum de 7 dies (wWeek, cel·les widget_day.xml; etiqueta «PREVISIÓ ▾» a la dreta de wSrc), que s'amaga si el widget és massa baix. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="8dp"
    android:background="@drawable/widget_bg_none">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="70dp"
        android:orientation="vertical"
        android:gravity="center_horizontal">
        <TextView
            android:id="@+id/wNowTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ARA"
            android:textColor="#9FB0C8"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.1"
            android:includeFontPadding="false"
            android:layout_marginBottom="2dp"
            android:maxLines="1" />
        <TextView
            android:id="@+id/wScore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="–"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:includeFontPadding="false"
            android:maxLines="1" />
        <TextView
            android:id="@+id/wVerd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:maxLines="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:orientation="vertical">
        <TextView
            android:id="@+id/wTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ocata Vent"
            android:textColor="#9FB0C8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/wWind"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Obre l'app per veure les condicions"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />
        <TextView
            android:id="@+id/wWave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E6ECF5"
            android:textSize="13sp"
            android:maxLines="1"
            android:ellipsize="end" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom">
            <TextView
                android:id="@+id/wSrc"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#9FB0C8"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end" />
            <!-- Etiqueta de la fila de 7 dies (a sota): només surt amb la fila -->
            <TextView
                android:id="@+id/wFcTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="PREVISIÓ ▾"
                android:textColor="#9FB0C8"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
  </LinearLayout>

    <LinearLayout
        android:id="@+id/wWeek"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:orientation="horizontal"
        android:visibility="gone" />
</LinearLayout>
